# Supabase project credentials.
# Copy this file to ".env" and fill in the values from your Supabase dashboard:
#   Project Settings -> Data API / API Keys
#
# The EXPO_PUBLIC_ prefix is REQUIRED so Expo exposes these to the app bundle.
# The anon key is safe to ship in a client app -- row level security (see
# supabase/schema.sql) is what actually protects your data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: used as the NCBI E-utilities "email" parameter (recommended etiquette).
EXPO_PUBLIC_NCBI_EMAIL=you@example.com
